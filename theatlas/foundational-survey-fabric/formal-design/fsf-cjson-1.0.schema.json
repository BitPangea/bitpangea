{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://bitpangea.com/schema/fsf-cjson-1.0.schema.json",
  "title":"FSF Canonical JSON 1.0",
  "type":"object",
  "$defs":{
    "integerString":{
      "type":"string",
      "pattern":"^(0|-?[1-9][0-9]*)$"
    },
    "positiveIntegerString":{
      "type":"string",
      "pattern":"^[1-9][0-9]*$"
    },
    "crpc":{
      "type":"object",
      "additionalProperties":false,
      "required":["d","n"],
      "properties":{
        "d":{"$ref":"#/$defs/positiveIntegerString"},
        "n":{"$ref":"#/$defs/integerString"}
      }
    },
    "point":{
      "type":"object",
      "additionalProperties":false,
      "required":["type","x","y"],
      "properties":{
        "type":{"const":"fsf.point"},
        "x":{"$ref":"#/$defs/crpc"},
        "y":{"$ref":"#/$defs/crpc"}
      }
    },
    "segment":{
      "type":"object",
      "additionalProperties":false,
      "required":["a","b","type"],
      "properties":{
        "a":{"$ref":"#/$defs/point"},
        "b":{"$ref":"#/$defs/point"},
        "type":{"const":"fsf.segment"}
      }
    },
    "scpe":{
      "type":"object",
      "additionalProperties":false,
      "required":["type","vertices"],
      "properties":{
        "type":{"const":"fsf.scpe"},
        "vertices":{
          "type":"array",
          "minItems":3,
          "items":{"$ref":"#/$defs/point"}
        }
      }
    },
    "surveyDomain":{
      "type":"object",
      "additionalProperties":false,
      "required":["format","type","x_max","x_min","y_max","y_min"],
      "properties":{
        "format":{"const":"FSF-CJSON-1.0"},
        "type":{"const":"fsf.survey-domain"},
        "x_max":{"$ref":"#/$defs/crpc"},
        "x_min":{"$ref":"#/$defs/crpc"},
        "y_max":{"$ref":"#/$defs/crpc"},
        "y_min":{"$ref":"#/$defs/crpc"}
      }
    },
    "geometry":{
      "oneOf":[
        {"$ref":"#/$defs/point"},
        {"$ref":"#/$defs/segment"},
        {"$ref":"#/$defs/scpe"}
      ]
    },
    "geometryPackage":{
      "type":"object",
      "additionalProperties":false,
      "required":["format","geometry","type"],
      "properties":{
        "format":{"const":"FSF-CJSON-1.0"},
        "geometry":{"$ref":"#/$defs/geometry"},
        "type":{"const":"fsf.geometry-package"}
      }
    }
  },
  "oneOf":[
    {"$ref":"#/$defs/surveyDomain"},
    {"$ref":"#/$defs/geometryPackage"}
  ]
}
